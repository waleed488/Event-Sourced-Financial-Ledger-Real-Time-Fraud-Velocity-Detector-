# MongoDB 3-Node Replica Set Connection String (inside Docker network)
MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0
DB_NAME=financial_ledger

# Express API Server Port
PORT=4000

# Set to "false" while running scripts/seed-500k.js to prevent a Change Stream storm
ENABLE_FRAUD_WORKER=true
